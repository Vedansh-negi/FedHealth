# Copy this file to .env and fill in your values. Never commit .env.

# PostgreSQL
FEDHEALTH_DB_HOST=localhost
FEDHEALTH_DB_PORT=5432
FEDHEALTH_DB_USER=krish
FEDHEALTH_DB_PASSWORD=

# JWT signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a random secret is generated at startup (all logins are
# invalidated every time the server restarts).
FEDHEALTH_JWT_SECRET=

# Token lifetime in minutes
FEDHEALTH_TOKEN_MINUTES=60

# Comma-separated list of allowed frontend origins (CORS)
FEDHEALTH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
